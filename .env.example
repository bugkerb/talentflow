NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-replace-with-service-role-key

AI_PROVIDER=openrouter
AI_MODEL=replace-with-production-model
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=TalentFlow

# Required for Module 1 real candidate discovery (never use a fixture endpoint).
DISCOVERY_SOURCE_ENDPOINT=
DISCOVERY_SOURCE_API_KEY=
FACEBOOK_GROUP_URL=
FACEBOOK_STORAGE_STATE_PATH=

# Required for Module 4 real Google Calendar/Meet scheduling.
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://talentflow-rose.vercel.app/api/integrations/google/callback
# 32-byte base64 key used to encrypt OAuth refresh tokens before Supabase storage.
GOOGLE_TOKEN_ENCRYPTION_KEY=
